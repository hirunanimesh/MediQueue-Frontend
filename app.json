{
  "expo": {
    "name": "MediQueue",
    "slug": "mediqueue-frontend",
    "scheme": "mediqueue",
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow MediQueue to access your photos so you can upload profile pictures."
        }
      ],
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
